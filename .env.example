# =============================================================================
# Last Storyteller environment template — NAMES only. Fill values in Render / .env.local.
# Never commit real secrets. Never paste secrets into chat.
# =============================================================================

# --- Public (safe for browser; NEXT_PUBLIC_* is inlined into the client) ---

# Supabase project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (RLS still applies; not a service role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production origin (no trailing slash). Used by getSiteUrl(), OG, sitemap.
# Production: https://laststoryteller.com
NEXT_PUBLIC_SITE_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) ---

# Cloudflare R2 — required for video > 50 MB (presigned multipart). Keep private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional R2 overrides
# Default endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public/custom-domain base for playback (no trailing slash). Prefer signed GET if unset.
R2_PUBLIC_URL=
# App max video bytes (default 1073741824 = 1 GiB). Must be >= 52428800 (50 MB).
R2_MAX_VIDEO_BYTES=

# OpenAI TTS narrator (/api/narrate). Without this, client falls back to browser SpeechSynthesis.
OPENAI_API_KEY=
# Optional model override (default tts-1-hd)
OPENAI_TTS_MODEL=

# Supabase service-role key for server-side admin email lookup. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend admin new-story notifications. Keep RESEND_API_KEY secret.
RESEND_API_KEY=
# Verified Resend sender, e.g. Last Storyteller <mattk@laststoryteller.com>
RESEND_FROM_EMAIL=
# Optional comma-separated fallback recipients if admin Auth email lookup fails.
ADMIN_NOTIFY_EMAIL=

# Web Push (generate with: npx web-push generate-vapid-keys).
# The public key is intentionally browser-visible; never commit VAPID_PRIVATE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Production: mailto:mattk@laststoryteller.com
VAPID_SUBJECT=

# --- Stripe (web Plus only). Leave empty until you explicitly enable test/live billing.
# Never commit live secrets. Do not use Checkout inside the iOS WebView.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for Last Storyteller Plus (web Checkout).
# Test mode: if this is empty and STRIPE_SECRET_KEY is sk_test_, Checkout uses
# the existing TEST price price_1UGFeWFNZZkempXKf2gMcxn6 (do not create another).
# Live mode: set this to the live Price ID. Never put secret keys here.
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Apple IAP (native). Leave empty until App Store Server API is enabled.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=

# --- Google Play Billing. Leave empty until Play is enabled.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Set automatically by Render (do not configure manually) ---
# RENDER_EXTERNAL_URL=
